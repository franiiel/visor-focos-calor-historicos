# Downloaded source data (untrusted, large)
tools/raw/

# Generated by serie.php at runtime
visor_deptos/cache/*
!visor_deptos/cache/.htaccess

# Monthly CSVs, one folder per source (datos/modis/, datos/viirs/): regenerate with the tools/ scripts
visor_deptos/datos/*/focos_*.csv

node_modules/

# Local agent tooling
.atl/

# NASA FIRMS downloads (raw input of tools/compute_anomalies.mjs, large)
DL_FIRE_*/

# Reference statistics written by tools/compute_anomalies.mjs
visor_deptos/datos/*/referencia.csv

# Windows executable built by tools/build_exe.mjs
dist/
